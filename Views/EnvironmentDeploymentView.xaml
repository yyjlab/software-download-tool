<UserControl x:Class="SoftwareDownloadCenter.Views.EnvironmentDeploymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBackgroundBrush}" Style="{StaticResource ApplicationPageStyle}">
    <UserControl.Resources>
        <Style x:Key="HeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="开发环境一键部署" Style="{StaticResource PageTitleTextStyle}"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="手动勾选，安装包自动获取并按组件安装；.NET SDK 使用系统目录。"
                               Margin="0,5,20,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="RefreshStatusButton" Grid.Column="1" Content="刷新状态"
                        Style="{StaticResource HeaderActionButtonStyle}" Margin="0,0,24,0"
                        Click="VerifyEnvironmentButton_Click" />
                <Button x:Name="OpenInstallRootButton" Grid.Column="2" Content="打开目录"
                        Style="{StaticResource HeaderActionButtonStyle}" ToolTip="D:\software"
                        Click="OpenInstallRoot_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,20,28,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardSurfaceStyle}" Margin="0,0,0,12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                                    <Border Grid.Column="1" Width="42" Height="42" Background="{StaticResource HoverBrush}"
                                            CornerRadius="{StaticResource ControlCornerRadius}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name[0]}" Foreground="{StaticResource PrimaryBrush}" FontSize="18"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="6,0,18,0" VerticalAlignment="Center">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ListTitleTextStyle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="  ·  " Foreground="#B2BBC5" />
                                            <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <ProgressBar Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                                     Value="{Binding Progress}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Style="{StaticResource BodyTextStyle}"
                                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DeploymentFooterText"
                           Text="请选择需要的组件。"
                           VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <Button x:Name="DeployEnvironmentButton" Grid.Column="1" Content="开始一键部署"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="130"
                        Click="DeployEnvironmentButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
