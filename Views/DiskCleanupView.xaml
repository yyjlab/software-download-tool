<UserControl x:Class="SoftwareDownloadCenter.Views.DiskCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBackgroundBrush}" FontFamily="{StaticResource AppFontFamily}"
             Style="{StaticResource ApplicationPageStyle}">
    <UserControl.Resources>
        <Style x:Key="DiskPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}" />
        <Style x:Key="CleanupCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource ToolCheckBoxStyle}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource HoverBrush}" CornerRadius="6" Height="42">
                        <Path Data="M2,9 L5,3 H19 L22,9 V21 H2 Z M2,9 H22 M16,16 H19"
                              Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="磁盘清理" Style="{StaticResource PageTitleTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="按已知规则清理缓存和临时文件" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="QuickActionPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Content="重新扫描" Width="96" Height="34"
                            Style="{StaticResource SecondaryButtonStyle}" Click="ScanButton_Click" />
                    <Button x:Name="CleanButton" Content="开始清理" Width="104" Height="36" Margin="10,0,0,0"
                            Style="{StaticResource DiskPrimaryButtonStyle}" Click="CleanButton_Click" IsEnabled="False" />
                </StackPanel>

            </Grid>
        </Border>

        <Grid x:Name="QuickCleanupPanel" Grid.Row="1" Margin="28,20,28,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <Grid Height="112">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceBorderBrush}" CornerRadius="8" Padding="1">
                        <Border CornerRadius="7" Padding="16,12">
                            <Border.Background><SolidColorBrush Color="White" /></Border.Background>
                            <StackPanel>
                                <TextBlock x:Name="DiskSpaceText" Text="系统盘 · 可用空间" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="DiskFreeSpaceText" Text="—" FontFamily="Segoe UI" FontSize="24"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                <ProgressBar x:Name="DiskUsageProgressBar" Height="4" Margin="0,6,0,6"
                                             Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#E1EAF4" BorderThickness="0" />
                                <TextBlock x:Name="DiskUsageText" Text="正在读取磁盘空间…" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBorderBrush}" CornerRadius="8" Padding="1">
                        <Border Background="White" CornerRadius="7" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="扫描发现" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="FoundSummaryText" Text="0 B" Margin="0,5,0,0" FontFamily="Segoe UI"
                                           FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="包括未勾选的项目" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="4" Background="{StaticResource SurfaceBorderBrush}" CornerRadius="8" Padding="1">
                        <Border Background="{StaticResource HoverBrush}" CornerRadius="7" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="已选择处理" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="SelectedSummaryText" Text="0 B" Margin="0,5,0,0" FontFamily="Segoe UI"
                                           FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock x:Name="SelectionDetailText" Text="0 项" Margin="0,6,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="2,12,2,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="清理项目" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="ScanStateText" Text="扫描在后台运行，可以取消" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SelectRecommendedButton" Content="选择推荐项" Padding="10,4" MinHeight="26"
                                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                Click="SelectRecommendedButton_Click" />
                        <Button x:Name="ClearSelectionButton" Content="取消选择" Padding="10,4" MinHeight="26"
                                Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                Click="ClearSelectionButton_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="QuickScanProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Height="3" Margin="0,7,0,0"
                                 Visibility="Collapsed" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" />
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBorderBrush}" CornerRadius="7" Padding="1">
                <Border Background="White" CornerRadius="6" Padding="10,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CleanupItemsControl" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="10,12" Margin="0,0,0,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource CleanupCheckBoxStyle}"
                                              AutomationProperties.Name="{Binding Name}"
                                              IsEnabled="{Binding IsEnabled}" ToolTip="{Binding Description}"
                                              Checked="CategorySelection_Changed"
                                              Unchecked="CategorySelection_Changed"
                                              VerticalAlignment="Center" MinWidth="24" MinHeight="24" />
                                    <Border Grid.Column="1" Background="{StaticResource HoverBrush}" CornerRadius="6" Width="32" Height="32"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Path Width="19" Height="19" Stretch="Uniform" Stroke="#7293B7" StrokeThickness="1.3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="M6,2 H15 L20,7 V22 H6 Z M15,2 V7 H20 M10,11 H16 M10,15 H16" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category.Id}" Value="windows-temp">
                                                            <Setter Property="Data" Value="M3,3 H11 V11 H3 Z M14,3 H22 V11 H14 Z M3,14 H11 V22 H3 Z M14,14 H22 V22 H14 Z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category.Id}" Value="thumbnail-cache">
                                                            <Setter Property="Data" Value="M3,4 H21 V20 H3 Z M3,16 L8,11 L12,15 L16,10 L21,16" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category.Id}" Value="crash-reports">
                                                            <Setter Property="Data" Value="M12,2 L22,20 H2 Z M12,8 V13 M12,16 V17" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category.Id}" Value="shader-cache">
                                                            <Setter Property="Data" Value="M12,2 L22,7 V17 L12,22 L2,17 V7 Z M2,7 L12,12 L22,7 M12,12 V22" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category.Id}" Value="downloads">
                                                            <Setter Property="Data" Value="M12,2 V15 M6,9 L12,15 L18,9 M3,17 V22 H21 V17" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category.Id}" Value="recycle-bin">
                                                            <Setter Property="Data" Value="M4,6 H20 M9,3 H15 M6,6 L7,22 H17 L18,6 M10,10 V18 M14,10 V18" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ListTitleTextStyle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequiresConfirmation}" Value="True">
                                                                <Setter Property="Background" Value="#FFF2DE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="推荐清理" />
                                                            <Setter Property="Foreground" Value="#087FC7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RequiresConfirmation}" Value="True">
                                                                    <Setter Property="Text" Value="需确认" />
                                                                    <Setter Property="Foreground" Value="#996018" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <Expander Header="查看判定依据" Margin="0,6,0,0" FontSize="12" Foreground="#58788C">
                                            <TextBlock Text="{Binding RuleEvidence}" TextWrapping="Wrap" Margin="4,5,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Expander>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="扫描完成">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar Height="2" Margin="0,6,0,0" IsIndeterminate="True"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SizeText}" FontSize="17" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding FileCountText}" Margin="0,4,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                        <Button Content="{Binding OpenFolderText}" Margin="0,8,0,0" Padding="10,4"
                                                MinHeight="26" FontSize="12" Style="{StaticResource SecondaryButtonStyle}"
                                                Tag="{Binding}" Click="OpenCleanupFolder_Click" ToolTip="{Binding FolderToolTip}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                </Border>
                </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Data="M7,1 L13,3 V8 C13,12 10,14 7,15 C4,14 1,12 1,8 V3 Z M4,7 L6,9 L10,5"
                      Width="12" Height="14" Stretch="Uniform" Stroke="#8DA7C1" StrokeThickness="1.2"
                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock x:Name="CleanupFooterText"
                           Grid.Column="1"
                           Text="仅扫描内置白名单目录，清理前需确认。"
                           VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
