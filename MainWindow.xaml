<Window x:Class="SoftwareDownloadCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SoftwareDownloadCenter.Views"
        Title="企业工具中心"
        Width="1080"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource AppLogoImage}"
        Style="{StaticResource ApplicationWindowStyle}"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <Style x:Key="SoftwareActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="#E8F4FC" />
            <Setter Property="BorderBrush" Value="#E8F4FC" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="4" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D8ECFA" />
                    <Setter Property="BorderBrush" Value="#D8ECFA" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C8E3F6" />
                    <Setter Property="BorderBrush" Value="#C8E3F6" />
                </Trigger>
                <DataTrigger Binding="{Binding ActionText}" Value="重新安装">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ActionText}" Value="重新安装" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                    <Setter Property="BorderBrush" Value="#B8DAEF" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ActionText}" Value="重新安装" />
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                </MultiDataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#536273" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CategoryBorder" Background="Transparent" CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="14,8" MinWidth="74">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBorder" Property="Background" Value="#EDF5FA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CategoryBorder" Property="Background" Value="#DDF1FC" />
                                <Setter Property="Foreground" Value="#087FC7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,0">
                    <Image Source="{StaticResource AppLogoImage}" Width="32" Height="32"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="企业工具中心" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="应用服务" Margin="34,8,0,5" Foreground="{StaticResource TextSecondaryBrush}"
                           Style="{StaticResource BodyTextStyle}" />

                <Border x:Name="SoftwareMenuBorder" Grid.Row="2" Height="44" Margin="14,0,14,4"
                        Style="{StaticResource NavigationItemStyle}" Tag="True"
                        MouseLeftButtonDown="SoftwareMenu_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SoftwareMenuText" Text="软件库"
                                   Foreground="{StaticResource PrimaryBrush}" Style="{StaticResource MenuTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="EnvironmentMenuBorder" Grid.Row="3" Height="44" Margin="14,4"
                        Style="{StaticResource NavigationItemStyle}"
                        MouseLeftButtonDown="EnvironmentMenu_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EnvironmentMenuText" Text="环境部署"
                                   Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource MenuTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" Text="系统工具" Margin="34,16,0,5" Foreground="{StaticResource TextSecondaryBrush}"
                           Style="{StaticResource BodyTextStyle}" />

                <Border x:Name="DiskCleanupMenuBorder" Grid.Row="5" Height="44" Margin="14,0,14,4"
                        Style="{StaticResource NavigationItemStyle}"
                        MouseLeftButtonDown="DiskCleanupMenu_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DiskCleanupMenuText" Text="磁盘清理"
                                   Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource MenuTextStyle}" />
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <Grid x:Name="SoftwareLibraryPage" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="GlassSearchBorder" Grid.Column="0" Height="36" Margin="0,0,10,0"
                            VerticalAlignment="Center" CornerRadius="18" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#CBDCE8" />
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FAFFFFFF" Offset="0" />
                                            <GradientStop Color="#EEF6FBFF" Offset="0.48" />
                                            <GradientStop Color="#E8EAF3FA" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#A9C9DD" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Border Margin="1" CornerRadius="16" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#EEFFFFFF" Offset="0" />
                                        <GradientStop Color="#20FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <Path Width="14" Height="14" Margin="13,0,0,0" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" Stroke="#71869A" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                                  Data="M 10,6 A 4,4 0 1 1 2,6 A 4,4 0 1 1 10,6 M 9,9 L 13,13" />
                            <TextBox x:Name="SearchTextBox" Padding="0" Margin="36,0,14,0" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center"
                                     FontSize="13" Foreground="#263746"
                                     ToolTip="输入软件名称或说明"
                                     TextChanged="SearchTextBox_TextChanged" />
                            <TextBlock Text="搜索软件" Margin="36,0,14,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="刷新" Width="76" Height="34" Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshButton_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="SoftwareStatusBanner" Grid.Row="1" Margin="12,0,12,8" Padding="10,4"
                    CornerRadius="6" Background="#EDF6FC" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FooterStatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatusText" Text="正在准备软件目录…" Margin="0,0,8,0"
                               VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button x:Name="DismissSoftwareStatusButton" Grid.Column="1" Content="×"
                            Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                            BorderThickness="0" ToolTip="关闭提示" AutomationProperties.Name="关闭提示"
                            Click="DismissSoftwareStatusButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SoftwareItemsControl" ItemsSource="{Binding SoftwareItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardSurfaceStyle}" Margin="0,0,0,8" Padding="18,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="132" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2" Width="42" Height="42" CornerRadius="{StaticResource ControlCornerRadius}"
                                                    VerticalAlignment="Center" Loaded="SoftwareIcon_Loaded">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                                <Setter Property="ToolTip" Value="暂无官方图标，显示通用软件图标" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Width="32" Height="32" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Source" Value="{Binding IconSource}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                                        <Setter Property="Source" Value="{StaticResource SoftwarePlaceholderImage}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                </Image>
                                            </Border>

                                            <TextBlock Grid.Column="1" Margin="4,0,20,0" Text="{Binding DisplayName}" Style="{StaticResource ListTitleTextStyle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Grid Grid.Row="1" Grid.Column="1" Margin="4,7,20,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="版本：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12" Foreground="#536273" Margin="0,0,12,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource BodyTextStyle}"
                                                       VerticalAlignment="Center" TextAlignment="Left"
                                                       Margin="20,7,16,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileSizeText}">
                                                <Run Text="大小：" Foreground="{StaticResource TextSecondaryBrush}" /><Run Text="{Binding FileSizeText, Mode=OneWay}" Foreground="#536273" />
                                            </TextBlock>

                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding StatusText}" Style="{StaticResource BodyTextStyle}"
                                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                                                       Margin="0,7,16,0" TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StatusText}" />

                                            <Button Grid.RowSpan="2" Grid.Column="4" Content="{Binding ActionText}"
                                                    Style="{StaticResource SoftwareActionButtonStyle}"
                                                    Tag="{Binding}" Click="InstallButton_Click"
                                                    IsEnabled="{Binding IsActionEnabled}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    MinWidth="76" />

                                            <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                                         Height="4" Margin="4,10,0,0" Minimum="0" Maximum="100"
                                                         Value="{Binding Progress}"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardSurfaceStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=SoftwareItemsControl, Path=HasItems}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="当前没有可显示的软件" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#536273" HorizontalAlignment="Center" />
                            <TextBlock Text="请在 catalog.json 中配置软件，或调整搜索条件。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

        </Grid>

        <views:EnvironmentDeploymentView x:Name="EnvironmentDeploymentPage" Grid.Column="1"
                                         Visibility="Collapsed" />
        <views:DiskCleanupView x:Name="DiskCleanupPage" Grid.Column="1"
                               Visibility="Collapsed" />
    </Grid>
</Window>
