<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SoftwareDownloadCenter</AssemblyName>
    <RootNamespace>SoftwareDownloadCenter</RootNamespace>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\app-icon.ico" />
    <EmbeddedResource Include="catalog.json" LogicalName="SoftwareDownloadCenter.Config.catalog.json" />
    <EmbeddedResource Include="environments.json" LogicalName="SoftwareDownloadCenter.Config.environments.json" />
    <EmbeddedResource Include="Assets\software-icons.json" LogicalName="SoftwareDownloadCenter.Assets.software-icons.json" />
    <EmbeddedResource Include="Assets\software-icon-names.json" LogicalName="SoftwareDownloadCenter.Assets.software-icon-names.json" />
  </ItemGroup>

</Project>
